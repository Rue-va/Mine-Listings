  <div class="wrap">
    <nav class="crumbs"><a href="/">Home</a> / <span>About us</span></nav>
    <h1>About <%= config.siteName %></h1>
    <p>A Harare-based listings service for mines and mining claims across Zimbabwe.</p>
  </div>
