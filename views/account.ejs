<%- include('partials/header') %>
<div class="wrap auth">
  <div class="panel auth-card">
    <h1>Your details</h1>
    <% if (errors.length) { %><div class="notice notice-error" role="alert"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
    <form action="/account" method="post" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="a-name">Full name</label><input id="a-name" name="name" required value="<%= user.name %>"></div>
      <div class="field"><label>Email</label><input value="<%= user.email %>" disabled></div>
      <div class="field"><label for="a-phone">Phone / WhatsApp</label><input id="a-phone" name="phone" value="<%= user.phone || '' %>"></div>
      <h3>Change password <small class="muted">(optional)</small></h3>
      <div class="field"><label for="a-cur">Current password</label><input id="a-cur" type="password" name="current_password" autocomplete="current-password"></div>
      <div class="field"><label for="a-new">New password</label><input id="a-new" type="password" name="new_password" minlength="8" autocomplete="new-password"></div>
      <button class="btn">Save</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
