</main>
<% const [brandName, ...brandTld] = config.siteName.split('.'); %>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand brand-light" href="/"><img class="brand-logo" src="/img/logo-miner-light.png" alt="" width="40" height="40"><span><%= brandName %><% if (brandTld.length) { %><span class="tld">.<%= brandTld.join('.') %></span><% } %></span></a>
      <p class="footer-blurb">A Harare-based listings service for mines, claims and mineral blocks across Zimbabwe. Every listing is reviewed before it is published.</p>
    </div>
    <div>
      <h4>Buy</h4>
      <a href="/mines">All listings</a>
      <a href="/minerals/gold">Gold</a>
      <a href="/minerals/chrome">Chrome</a>
      <a href="/minerals/lithium">Lithium</a>
    </div>
    <div>
      <h4>Sell</h4>
      <a href="/sell">List your mine</a>
      <a href="/how-it-works">How it works</a>
      <a href="/dashboard">Your dashboard</a>
    </div>
    <div>
      <h4>Company</h4>
      <a href="/about">About us</a>
      <a href="/contact">Contact</a>
      <a href="mailto:<%= config.contactEmail %>"><%= config.contactEmail %></a>
      <% if (config.contactPhone) { %><a href="tel:<%= config.contactPhone.replace(/\s/g, '') %>"><%= config.contactPhone %></a><% } %>
    </div>
  </div>
  <div class="wrap footer-legal">
    <span>&copy; <%= new Date().getFullYear() %> <%= config.siteName %>. Listings are provided by sellers and their mandate holders. Always do your own due diligence.</span>
    <span class="legal-links">
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
      <a href="/cookies">Cookies</a>
      <a href="/image-credits">Image credits</a>
      <button type="button" class="link-btn" data-cookie-settings>Cookie settings</button>
    </span>
  </div>
</footer>

<% if (config.whatsapp) { %>
<a class="wa-float" href="https://wa.me/<%= config.whatsapp %>?text=<%= encodeURIComponent('Hi, I found you on ' + config.siteName + ' and have a question.') %>" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"/></svg>
</a>
<% } %>

<%# Cookie consent. Nothing beyond strictly-necessary cookies is set until the visitor chooses. %>
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie consent" <%= cookieConsent ? 'hidden' : '' %>>
  <div class="cookie-banner-inner">
    <div class="cookie-text">
      <strong>Cookies on this site</strong>
      <p>We use essential cookies to keep you signed in and keep forms secure. With your permission we'd also use analytics cookies to see which listings are useful, and marketing cookies to measure our adverts. You can change this at any time. <a href="/cookies">Cookie policy</a></p>
    </div>
    <div class="cookie-actions">
      <button type="button" class="btn btn-ghost" data-cookie-action="settings">Settings</button>
      <button type="button" class="btn btn-ghost" data-cookie-action="reject">Essential only</button>
      <button type="button" class="btn" data-cookie-action="accept">Accept all</button>
    </div>
  </div>
</div>

<div class="modal" id="cookie-modal" hidden>
  <div class="modal-backdrop" data-cookie-close></div>
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="cookie-modal-title">
    <button type="button" class="modal-x" data-cookie-close aria-label="Close">&times;</button>
    <h3 id="cookie-modal-title">Your cookie choices</h3>
    <p class="muted">Pick what you're comfortable with. We'll remember your choice for six months.</p>
    <div class="cookie-cat">
      <div><strong>Essential</strong><p>Sign-in, security (CSRF protection) and remembering this choice. The site can't work without these.</p></div>
      <label class="switch"><input type="checkbox" checked disabled><span></span></label>
    </div>
    <div class="cookie-cat">
      <div><strong>Analytics</strong><p>Anonymous counts of which pages and listings get visited, so we know what's useful.</p></div>
      <label class="switch"><input type="checkbox" id="cc-analytics"><span></span></label>
    </div>
    <div class="cookie-cat">
      <div><strong>Marketing</strong><p>Lets us see whether our adverts on other sites brought you here.</p></div>
      <label class="switch"><input type="checkbox" id="cc-marketing"><span></span></label>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn btn-ghost" data-cookie-action="reject">Essential only</button>
      <button type="button" class="btn" data-cookie-action="save">Save my choices</button>
    </div>
  </div>
</div>

<script>window.COOKIE_CONSENT_VERSION = <%= config.cookieConsentVersion %>;</script>
<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
<%# Example of a consent-gated script: it only runs after the visitor allows analytics.
    Replace the body with your analytics snippet (e.g. Google Analytics / Plausible). %>
<script type="text/plain" data-cookie-category="analytics">
  console.info('Analytics consent given. Load your analytics script here.');
</script>
</body>
</html>
