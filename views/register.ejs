<%- include('partials/header') %>
<div class="wrap auth">
  <div class="panel auth-card">
    <h1>Create your account</h1>
    <p class="muted">One account for buying and selling. It's free and takes under a minute.</p>
    <% if (errors.length) { %>
      <div class="notice notice-error" role="alert"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
    <% } %>
    <form action="/register" method="post" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field"><label for="r-name">Full name</label><input id="r-name" name="name" required autocomplete="name" value="<%= form.name || '' %>"></div>
      <div class="field"><label for="r-email">Email</label><input id="r-email" type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>"></div>
      <div class="field"><label for="r-phone">Phone / WhatsApp</label><input id="r-phone" type="tel" name="phone" required autocomplete="tel" value="<%= form.phone || '' %>" placeholder="0771234567 or +263771234567"></div>
      <div class="field"><label for="r-pw">Password</label><input id="r-pw" type="password" name="password" required minlength="8" autocomplete="new-password"><small class="muted">At least 8 characters.</small></div>
      <label class="check small"><input type="checkbox" name="agree" required> I've read and accept the <a href="/terms" target="_blank">Terms &amp; Conditions</a> and <a href="/privacy" target="_blank">Privacy Policy</a>.</label>
      <button class="btn btn-block">Create account</button>
    </form>
    <p class="auth-alt">Already registered? <a href="/login<%= next ? `?next=${encodeURIComponent(next)}` : '' %>">Sign in</a></p>
  </div>
</div>
<%- include('partials/footer') %>
